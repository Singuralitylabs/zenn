# OpenAI API Key (Whisper + GPT-4o)
OPENAI_API_KEY=sk-your-openai-api-key-here

# GitHub Personal Access Token (for code snippet fetching)
GITHUB_TOKEN=ghp_your-github-token-here

# GitHub repository (owner/repo)
GITHUB_REPO=Singuralitylabs/portal-site

# LLM model for article generation (default: gpt-4o)
LLM_MODEL=gpt-4o

# Whisper model (default: whisper-1)
WHISPER_MODEL=whisper-1
